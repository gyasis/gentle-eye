.DS_Store

# rust build artifacts
# Anchored to the repo root so it ONLY ignores the build dir, NOT the
# `src/target/` source module (the unanchored `target/` matched both).
/target/
**/*.rs.bk

# recovery archives + artifacts (kept on disk, NEVER committed — may hold
# secrets/cross-project data from recovered sessions)
RECOVERY/
recovered/
recovered_source/
recovered_validated/
recovered_trimmed/
recovered_review/
_v2_recovery/
*.raw.*
*.synthesized.*
*.partial
*.corrupted-upgrade-*
*.corrupted*
# recovered launch dump (455KB, contained a hardcoded API key)
scripts/launch.sh

# session / agent state — local only (churn from the checkpoint hook; private notes)
.claude/activity_stream.md
.claude/system_bus.json
.claude/session_snapshots/
memory-bank/private/

# editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# env / secrets
.env
.env.local

# databases / recordings
recordings/
*.db
*.sqlite
.tooling/

# machine-local config (private LAN addresses; not for the public repo)
dev-kid.yml
ralph.config.yaml
ralph-tiers.json
ralph-tiers.full-13.bak.json

# dev-kid generated wave plan — regenerate with `dev-kid orchestrate`.
# NOT tracked: a stale plan for a different feature was committed once and would
# have silently executed the wrong waves (task ids collide across features).
execution_plan.json
